WITH FlattenedData AS (
    SELECT
        'Apollo' AS Device,
        meterData.ArrayValue AS MeterData,
        input.PartitionId
    FROM
        [ApolloG3Link] AS input
    CROSS APPLY GetArrayElements(input.[Apollo]) AS meterData
),
ExtractedData AS (
    SELECT
        CAST(GetRecordPropertyValue(MeterData, 'RecOn') AS datetime) AS RecOn,
        GetRecordPropertyValue(MeterData, 'Key') AS [Key],
        CAST(GetRecordPropertyValue(MeterData, 'Val') AS float) AS Val,
        GetRecordPropertyValue(MeterData, 'Meter') AS Meter,
        FlattenedData.PartitionId AS PartitionId
    FROM
        FlattenedData
),
AggregatedData AS (
    SELECT
        DATEADD(minute, DATEDIFF(minute, '1900-01-01', ExtractedData.RecOn) / 15 * 15, '1900-01-01') AS DateTime,
        ExtractedData.Meter,
        MAX(CAST(CASE WHEN ExtractedData.[Key] = 'kWh_IMP' THEN ExtractedData.Val ELSE NULL END AS FLOAT)) AS kWh_IMP,
        MAX(CAST(CASE WHEN ExtractedData.[Key] = 'kWh_EXP' THEN ExtractedData.Val ELSE NULL END AS FLOAT)) AS kWh_EXP,
        MAX(CAST(CASE WHEN ExtractedData.[Key] = 'kvarh_IMP' THEN ExtractedData.Val ELSE NULL END AS FLOAT)) AS kvarh_IMP,
        MAX(CAST(CASE WHEN ExtractedData.[Key] = 'kvarh_EXP' THEN ExtractedData.Val ELSE NULL END AS FLOAT)) AS kvarh_EXP,
        MAX(CAST(CASE WHEN ExtractedData.[Key] = 'kVAh' THEN ExtractedData.Val ELSE NULL END AS FLOAT)) AS kVAh,
        MAX(CAST(CASE WHEN ExtractedData.[Key] = 'V' THEN ExtractedData.Val ELSE NULL END AS FLOAT)) AS V1,
        MAX(CAST(CASE WHEN ExtractedData.[Key] = 'I' THEN ExtractedData.Val ELSE NULL END AS FLOAT)) AS I1,
        MAX(CAST(CASE WHEN ExtractedData.[Key] = 'kW' THEN ExtractedData.Val ELSE NULL END AS FLOAT)) AS kW1,
        ExtractedData.PartitionId -- Include PartitionId for partitioning
    FROM
        ExtractedData
    LEFT JOIN
        LatestMeterData
    ON
        ExtractedData.Meter = LatestMeterData.Meter
    GROUP BY
        DATEADD(minute, DATEDIFF(minute, '1900-01-01', ExtractedData.RecOn) / 15 * 15, '1900-01-01'),
        TumblingWindow(minute, 15),
        ExtractedData.Meter,
        ExtractedData.PartitionId -- Group by PartitionId for parallelism

    UNION ALL

    -- Chunk 2: Second JSON structure with its own HAVING logic
    SELECT
        DATEADD(minute, DATEDIFF(minute, '1900-01-01', RecOn) / 15 * 15, '1900-01-01') AS DateTime,
        Meter,
        MAX(CAST(CASE WHEN [Key] = 'kWh_IMP' THEN Val ELSE NULL END AS FLOAT)) AS kWh_IMP,
        MAX(CAST(CASE WHEN [Key] = 'kWh_EXP' THEN Val ELSE NULL END AS FLOAT)) AS kWh_EXP,
        MAX(CAST(CASE WHEN [Key] = 'kvarh_IMP' THEN Val ELSE NULL END AS FLOAT)) AS kvarh_IMP,
        MAX(CAST(CASE WHEN [Key] = 'kvarh_EXP' THEN Val ELSE NULL END AS FLOAT)) AS kvarh_EXP,
        MAX(CAST(CASE WHEN [Key] = 'kVAh' THEN Val ELSE NULL END AS FLOAT)) AS kVAh,
        MAX(CAST(CASE WHEN [Key] = 'V' THEN Val ELSE NULL END AS FLOAT)) AS V1,
        MAX(CAST(CASE WHEN [Key] = 'I' THEN Val ELSE NULL END AS FLOAT)) AS I1,
        MAX(CAST(CASE WHEN [Key] = 'kW' THEN Val ELSE NULL END AS FLOAT)) AS kW1,
        PartitionId -- Include PartitionId for partitioning
    FROM
        [ApolloG3Link]
    WHERE RecOn IS NOT NULL
    GROUP BY
        DATEADD(minute, DATEDIFF(minute, '1900-01-01', RecOn) / 15 * 15, '1900-01-01'),
        TumblingWindow(minute, 15),
        Meter,
        PartitionId -- Group by PartitionId for parallelism
)



from sqlalchemy.exc import SQLAlchemyError

def main(date):
    if not date:
        date = (datetime.today() - timedelta(days=1)).strftime("%Y-%m-%d")

    logging.info(f"Processing data for date: {date}")

    # Fetch meter data
    meter_data = fetch_meter_data()

    # Fetch tariff data
    all_tariff_data = fetch_all_tariff_data(date)

    # Find unique projects
    unique_projects = meter_data['ProjectName'].unique()

    for project_name in unique_projects:
        # Get tariff data for the project
        project_tariff_data = all_tariff_data[all_tariff_data['Bundled_Tariff'] == meter_data[meter_data['ProjectName'] == project_name]['Tariff'].iloc[0]]
        if not project_tariff_data.empty:
            # Filter meters for this project
            project_meters = meter_data[meter_data['ProjectName'] == project_name]

            for _, meter_row in project_meters.iterrows():
                meter = meter_row['Meter']
                status = meter_row['Status']
                exp_flag = meter_row['EXP']
                print(f"Processing Meter '{meter}' in Project '{project_name}' with status '{status}' and EXP flag '{exp_flag}'.")

                # Fetch data for the specific meter
                meter_data_details, prev_data, curr_data = fetch_meter_data_with_previous(meter, date)
                if meter_data_details is not None:
                    cleaned_data = clean_meter_data(meter_data_details, prev_data)

                    if cleaned_data is not None:
                        # Determine calculation type
                        tariff_type = project_tariff_data['TYPE'].iloc[0]
                        consumption = calculate_consumption(cleaned_data, tariff_type, exp_flag)
                        print(f"Consumption for Meter '{meter}': {consumption}")

                        # Generate invoice
                        invoice = generate_invoice(consumption, project_tariff_data.iloc[0].to_dict(), date, meter)
                        print(invoice.to_string(index=False))

                        try:
                            # Upload cleaned data
                            cleaned_data[CLEANED_DATA_COLUMNS].to_sql(
                                'CleanedDataTable', con=engine, if_exists='append', index=False
                            )

                            # Upload invoice
                            invoice[INVOICE_COLUMNS].to_sql(
                                'InvoiceTable', con=engine, if_exists='append', index=False
                            )
                            print(f"Data uploaded for Meter '{meter}' successfully.")
                        except SQLAlchemyError as e:
                            logging.error(f"Error uploading data for Meter '{meter}': {e}")
                else:
                    print(f"No data on {date} for Meter '{meter}'")

        else:
            logging.warning(f"No tariff data found for Project '{project_name}'.")

