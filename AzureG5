WITH ProjectIntervals AS (
    SELECT
        ProjectName,
        ReadingFrequency_Mins AS Interval
    FROM
        [Meter_Table]
),

-- Process ApolloG3 Data
FlattenedApolloG3 AS (
    SELECT
        'ApolloG3' AS Device,
        meterData.ArrayValue AS MeterData,
        input.PartitionId
    FROM
        [ApolloG3Link] AS input
    CROSS APPLY GetArrayElements(input.[Apollo]) AS meterData
),
ExtractedApolloG3 AS (
    SELECT
        CAST(GetRecordPropertyValue(MeterData, 'RecOn') AS datetime) AS RecOn,
        GetRecordPropertyValue(MeterData, 'Key') AS [Key],
        CAST(GetRecordPropertyValue(MeterData, 'Val') AS float) AS Val,
        GetRecordPropertyValue(MeterData, 'Meter') AS Meter,
        FlattenedApolloG3.PartitionId AS PartitionId
    FROM
        FlattenedApolloG3
),
AggregatedApolloG3 AS (
    SELECT
        DATEADD(minute, DATEDIFF(minute, '1900-01-01', RecOn) / Interval * Interval, '1900-01-01') AS DateTime,
        Meter,
        MAX(CASE WHEN [Key] = 'kWh_IMP' THEN Val ELSE NULL END) AS kWh_IMP,
        MAX(CASE WHEN [Key] = 'kWh_EXP' THEN Val ELSE NULL END) AS kWh_EXP,
        MAX(CASE WHEN [Key] = 'kvarh_IMP' THEN Val ELSE NULL END) AS kvarh_IMP,
        MAX(CASE WHEN [Key] = 'kvarh_EXP' THEN Val ELSE NULL END) AS kvarh_EXP,
        MAX(CASE WHEN [Key] = 'kVAh' THEN Val ELSE NULL END) AS kVAh,
        MAX(CASE WHEN [Key] = 'V' THEN Val ELSE NULL END) AS V1,
        MAX(CASE WHEN [Key] = 'I' THEN Val ELSE NULL END) AS I1,
        MAX(CASE WHEN [Key] = 'kW' THEN Val ELSE NULL END) AS kW1,
        PartitionId
    FROM
        ExtractedApolloG3
    JOIN
        ProjectIntervals
    ON
        ProjectIntervals.ProjectName = 'Apollo'
    GROUP BY
        TumblingWindow(minute, Interval),
        Meter,
        PartitionId
    UNION ALL
-- Chunk 2: Second JSON structure with its own HAVING logic
    SELECT
        DATEADD(minute, DATEDIFF(minute, '1900-01-01', RecOn) / Interval * Interval, '1900-01-01') AS DateTime,
        Meter,
        MAX(CAST(CASE WHEN [Key] = 'kWh_IMP' THEN Val ELSE NULL END AS FLOAT)) AS kWh_IMP,
        MAX(CAST(CASE WHEN [Key] = 'kWh_EXP' THEN Val ELSE NULL END AS FLOAT)) AS kWh_EXP,
        MAX(CAST(CASE WHEN [Key] = 'kvarh_IMP' THEN Val ELSE NULL END AS FLOAT)) AS kvarh_IMP,
        MAX(CAST(CASE WHEN [Key] = 'kvarh_EXP' THEN Val ELSE NULL END AS FLOAT)) AS kvarh_EXP,
        MAX(CAST(CASE WHEN [Key] = 'kVAh' THEN Val ELSE NULL END AS FLOAT)) AS kVAh,
        MAX(CAST(CASE WHEN [Key] = 'V' THEN Val ELSE NULL END AS FLOAT)) AS V1,
        MAX(CAST(CASE WHEN [Key] = 'I' THEN Val ELSE NULL END AS FLOAT)) AS I1,
        MAX(CAST(CASE WHEN [Key] = 'kW' THEN Val ELSE NULL END AS FLOAT)) AS kW1,
        PartitionId
    FROM
        [ApolloG3Link]
    JOIN
        ProjectIntervals
    ON
        ProjectIntervals.ProjectName = 'Apollo'
    GROUP BY
        TumblingWindow(minute, Interval),
        Meter,
        PartitionId
),

-- Process ScarboroughG5 Data
ExtractedScarboroughG5 AS (
    SELECT
        DATEADD(minute, DATEDIFF(minute, '1900-01-01', RecOn) / Interval * Interval, '1900-01-01') AS DateTime,
        SUBSTRING([Key], 1, CHARINDEX('_', [Key]) - 1) AS Meter_No,
        [Key],
        CAST(Val AS FLOAT) AS Val,
        PartitionId
    FROM
        [ScarboroughG5Link]
    JOIN
        ProjectIntervals
    ON
        ProjectIntervals.ProjectName = 'Scarborough'
),
AggregatedDataG5 AS (
    SELECT
        ExtractedScarboroughG5.DateTime,
        ExtractedScarboroughG5.Meter_No AS Meter,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_V_L1' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS V1,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_V_L2' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS V2,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_V_L3' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS V3,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_I_L1' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS I1,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_I_L2' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS I2,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_I_L3' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS I3,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_kW_L1' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS kW1,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_kW_L2' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS kW2,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_kW_L3' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS kW3,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_kWh_IMP_Total' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS kWh_IMP,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_kWh_EXP_Total' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS kWh_EXP,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_kvarh_IMP_Total' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS kvarh_IMP,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_kvarh_EXP_Total' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS kvarh_EXP,
        MAX(CASE WHEN ExtractedScarboroughG5.[Key] LIKE '%_kVAh_Total' THEN ExtractedScarboroughG5.Val ELSE NULL END) AS kVAh,
        ExtractedScarboroughG5.PartitionId
    FROM
        ExtractedScarboroughG5
    GROUP BY
        ExtractedScarboroughG5.Meter_No,
        ExtractedScarboroughG5.DateTime,
        TumblingWindow(minute, Interval),
        ExtractedScarboroughG5.PartitionId
),

-- Combine Data
CombinedData AS (
    SELECT * FROM AggregatedApolloG3
    UNION ALL
    SELECT * FROM AggregatedDataG5
)

-- Write Combined Data to OUTPUT Table
SELECT
    DateTime,
    kWh_IMP,
    kWh_EXP,
    kvarh_IMP,
    kvarh_EXP,
    kVAh,
    V1,
    I1,
    kW1,
    V2,
    V3,
    I2,
    I3,
    kW2,
    kW3,
    Meter,
    PartitionId
INTO [Meter_Output_Detail]
FROM CombinedData;
